// Indexes are used to make querying more efficient
db.supportTickets.createIndex(
  { labels: 1 },
  { name: "idx_labels" }	// Note: if you do not provide a name, mongo will automatically generate one for you
);


// A the 'unique' property indicates that the value on each document for
// this field will be unique, which impacts the internal ordering/optimization
// performed by Mongo. - Note: for this example, 'subject' would be a poor
// field for a 'unique' index
db.supportTickets.createIndex(
  { subject: 1 },
  { name: "idx_subject_unique", unique: true }
);

// use dropIndex to remove an index by it's name (either your custom given
// name or the name generated by mongo)
db.supportTickets.dropIndex("idx_subject_unique");


// use getIndexes to list  existing indexes. If Mongo generated the index name, 
// you can find the name using this function
db.supportTickets.getIndexes();